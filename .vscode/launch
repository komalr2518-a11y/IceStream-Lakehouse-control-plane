{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IceStream API: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}\\backend",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "IceStream UI: Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "IceStream: Debug full stack",
      "configurations": ["IceStream API: Debug", "IceStream UI: Debug"]
    }
  ]
}
